{
  "schemaVersion": "4.0",
  "moduleVersion": "2.1.1.0-Beta",
  "status": "Beta – manueller, messwertbezogener VDE-Messwertprüfer",
  "scope": "Rechnerische Zweitkontrolle manuell eingegebener Messwerte gegen vollständig angegebene, freigegebene Bewertungsgrundlagen",
  "automaticInput": {
    "photo": false,
    "pdf": false,
    "ocr": false,
    "protocolRecognition": false
  },
  "excludedFromEvaluation": [
    "Formularidentität",
    "OCR-Ergebnisse",
    "PDF- oder Fotoeigenschaften",
    "Protokollaufbau",
    "Unterschriften",
    "Namen",
    "Datum",
    "Ortsangaben",
    "Kreuze",
    "Freitext",
    "sonstige formale Angaben"
  ],
  "governance": {
    "numericDefaultsAllowed": false,
    "contextDependentLimitsRequireAdditionalInputsOrApprovedSetpoint": true,
    "queryOnlyCalculationRelevantInputs": true,
    "queryEachMissingInput": true,
    "finalResultWhileInputsMissing": false,
    "invalidInputProducesVerdict": false,
    "boundaryComparisonIsInclusive": true,
    "toolIsSecondCheckOnly": true,
    "commissioningApproval": false,
    "responsibleElectricianReplacement": false
  },
  "rules": [
    {"id":"VD-PERCENT","measurement":"Spannungsfall","formula":"ΔU%gemessen ≤ ΔU%max, freigegeben","limitSource":"manuell eingegebener freigegebener Sollwert"},
    {"id":"VD-DU","measurement":"Spannungsfall","formula":"ΔU% = ΔU / Un × 100; Ergebnis ≤ ΔU%max, freigegeben","limitSource":"manuell eingegebener freigegebener Sollwert"},
    {"id":"INS-MIN","measurement":"Isolationsmessung","formula":"RISO,min gemessen ≥ RISO,min freigegeben","limitSource":"manuell eingegebener freigegebener Sollwert"},
    {"id":"DISC-ZS-APPROVED","measurement":"Schleifenimpedanz","formula":"Zs,gemessen ≤ Zs,max freigegeben","limitSource":"manuell eingegebener freigegebener Sollwert"},
    {"id":"DISC-ZS-FORMULA","measurement":"Schleifenimpedanz","formula":"Zs,max = U0 / Ia; Zs,gemessen ≤ Zs,max","limitSource":"U0 und fachlich freigegebener Auslösestrom Ia"},
    {"id":"DISC-IK","measurement":"Kurzschlussstrom","formula":"Ik,gemessen ≥ Ia,erforderlich","limitSource":"fachlich freigegebener Auslösestrom Ia"},
    {"id":"RCD-TIME","measurement":"RCD-Auslösezeit","formula":"tA,gemessen ≤ tA,max freigegeben","limitSource":"manuell eingegebener Grenzwert passend zu RCD-Typ und Prüfmodus"},
    {"id":"RCD-CURRENT","measurement":"RCD-Auslösestrom","formula":"IΔ,min freigegeben ≤ IΔ,gemessen ≤ IΔ,max freigegeben","limitSource":"manuell eingegebener Grenzbereich passend zu RCD-Typ und Prüfmodus"},
    {"id":"CONT-MAX","measurement":"Niederohmigkeit","formula":"RPE,gemessen ≤ RPE,max freigegeben","limitSource":"manuell eingegebener freigegebener Sollwert"},
    {"id":"BOND-MAX","measurement":"Schutzpotentialausgleich","formula":"RPA,gemessen ≤ RPA,max freigegeben","limitSource":"manuell eingegebener freigegebener Sollwert"}
  ],
  "projectDocumentation": "VDE0100-600-MESSWERTPRUEFER.md"
}
